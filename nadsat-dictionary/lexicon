def searchable_forms(term_field):
    """Return every form of a term field that a user can search for.

    "guff, guffaw" gives each synonym. "horrorshow (xorosho)" gives the full
    form, the main word, and the alternate.
    """
    if ',' in term_field:
        entries = [s.strip() for s in term_field.split(',') if s.strip()]
    else:
        entries = [term_field]

    forms = []
    for entry in entries:
        forms.append(entry)
        match = re.match(r'^(.+?)\s*\((.+?)\)\s*$', entry)
        if match:
            forms.append(match.group(1).strip())
            forms.append(match.group(2).strip())
    return forms


def load_dictionary_from_data(dictionary=DEFAULT_DICTIONARY):
    """Load one embedded dictionary as a list of searchable word entries.

    Each searchable form of a term becomes its own entry. All forms of a term
    share the same definition and keep the original field for display.
    """
    words = []
    for row in DICTIONARY_DATA[dictionary]:
        term_field = row['Term'].strip()
        if not term_field:
            continue
        entry = {
            'meaning': row.get('Meaning', '').strip(),
            'origin': row.get('Origin', '').strip(),
            'type': row.get('Type', '').strip(),
            'first_appearance': row.get('First appearance', '').strip(),
            'original_term': term_field,
        }
        for form in searchable_forms(term_field):
            words.append({'term': form, **entry})
    return words


def get_words_by_letter(words, letter):
    """Get all words starting with the given letter (case-insensitive)."""
    letter = letter.lower()
    return [w for w in words if w['term'].lower().startswith(letter)]


def get_words_by_length(words, length):
    """Get all words whose searchable spelling has the given length."""
    return [w for w in words if len(w['term']) == length]


def find_word(words, search_term):
    """Find exact match for a word (case-insensitive)."""
    search_term = search_term.lower()
    for word in words:
        if word['term'].lower() == search_term:
            return word
    return None


