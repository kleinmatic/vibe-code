    print(f"  {meta['meaning_label']}: {word['meaning']}")
    if word['origin']:
        print(f"  {meta['origin_label']}: {word['origin']}")
    if word['type']:
        print(f"  Type: {word['type']}")
    if word['first_appearance']:
        print(f"  First appears: {word['first_appearance']}")
    print()


def display_length_matches(words, length, dictionary=DEFAULT_DICTIONARY):
    """Display up to three random words with the requested length."""
    name = DICTIONARIES[dictionary]['name']
    matching = get_words_by_length(words, length)

    if not matching:
        print(f"\nNo {name} words found with length {length}")
        return

    sample_size = min(3, len(matching))
    selected = random.sample(matching, sample_size)

    print(f"\n=== {sample_size} Random {name} Word(s) of Length {length} ===")
    for word in selected:
        # Show the exact form that matched so its displayed length is unambiguous.
        display_word(word, use_searchable_form=True, dictionary=dictionary)


def parse_length(value):
    """Parse a command-line length value, exiting with a useful error if invalid."""
    try:
        length = int(value)
    except ValueError:
        print("Error: length must be a positive integer.", file=sys.stderr)
        sys.exit(1)

    if length <= 0:
        print("Error: length must be a positive integer.", file=sys.stderr)
        sys.exit(1)

    return length


def choose_dictionary(argv):
    """Remove -d/--dict from argv and return (dictionary, remaining args, program name).

    With no option, the program name selects the dictionary if it matches one
    (for example, a launcher called `newspeak`). Otherwise use the default.
    """
    prog = os.path.basename(argv[0]) if argv else 'lexicon'
    prog_stem = os.path.splitext(prog)[0]
    args = list(argv[1:])
    chosen = None

    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ('-d', '--dict'):
            if i + 1 >= len(args):
                print("Error: --dict requires a dictionary name.", file=sys.stderr)
                sys.exit(1)
            chosen = args[i + 1]
            del args[i:i + 2]
        elif arg.startswith('--dict='):
            chosen = arg.split('=', 1)[1]
            del args[i]
        else:
            i += 1

    if chosen is None:
        chosen = prog_stem if prog_stem in DICTIONARIES else DEFAULT_DICTIONARY

    chosen = chosen.strip().lower()
    if chosen not in DICTIONARIES:
        names = ', '.join(sorted(DICTIONARIES))
        print(f"Error: unknown dictionary '{chosen}'. Choose one of: {names}.",
              file=sys.stderr)
        sys.exit(1)

    return chosen, args, prog_stem


def print_usage(prog, dictionary):
    name = DICTIONARIES[dictionary]['name']
    print("Usage:")
    print(f"  {prog}                - Get a random {name} word")
    print(f"  {prog} <letter>       - Get 3 random words starting with that letter")
    print(f"  {prog} <word>         - Look up a specific word")
    print(f"  {prog} -l, --length N - Get 3 random words of a particular length")
    print(f"  {prog} -v, --version  - Show version and credits")
    print(f"  {prog} -h, --help     - Show this help")
    if prog not in DICTIONARIES:
        print(f"  {prog} -d, --dict NAME - Choose a dictionary: "
              f"{', '.join(sorted(DICTIONARIES))} (default: {DEFAULT_DICTIONARY})")


def main(argv=None):
    argv = sys.argv if argv is None else argv
    dictionary, args, prog = choose_dictionary(argv)
    meta = DICTIONARIES[dictionary]
    name = meta['name']

    if len(args) == 1 and args[0] in ['-h', '--help']:
        print_usage(prog, dictionary)
        sys.exit(0)

    if len(args) == 1 and args[0] in ['-v', '--version']:
        print(f"{prog} version {__version__}")
        print()
        print(f"{name} Dictionary Tool")
        print(meta['description'])
        print()
        for line in meta['credits']:
            print(line)
        sys.exit(0)

    words = load_dictionary_from_data(dictionary)

    if len(args) == 0:
        random_word = random.choice(words)
        print(f"\n=== Random {name} Word ===")
        display_word(random_word, dictionary=dictionary)

    elif len(args) == 2 and args[0] in ['-l', '--length']:
        length = parse_length(args[1].strip())
        display_length_matches(words, length, dictionary)

    elif len(args) == 1 and args[0].startswith('--length='):
        length = parse_length(args[0].split('=', 1)[1].strip())
        display_length_matches(words, length, dictionary)

    elif len(args) == 1:
        arg = args[0].strip()

        if arg in ['-l', '--length']:
            print("Error: --length requires a positive integer.", file=sys.stderr)
            sys.exit(1)

        if len(arg) == 1:
            matching = get_words_by_letter(words, arg)

            if not matching:
                print(f"\nNo {name} words found starting with '{arg}'")
                sys.exit(0)

            sample_size = min(3, len(matching))
            selected = random.sample(matching, sample_size)

            print(f"\n=== {sample_size} Random {name} Word(s) Starting with '{arg.upper()}' ===")
            for word in selected:
                display_word(word, dictionary=dictionary)

        else:
            result = find_word(words, arg)

            if result:
                print(f"\n=== {name} Word Definition ===")
                display_word(result, dictionary=dictionary)
            else:
                print(f"\nWord '{arg}' not found in {name} dictionary.")
                sys.exit(0)

    else:
        print_usage(prog, dictionary)
        sys.exit(1)


if __name__ == '__main__':
    main()
